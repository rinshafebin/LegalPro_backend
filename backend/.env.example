# Copy to .env and fill in. Never commit .env.
# docker-compose overrides the *_URL / S3 endpoint values with in-network hostnames.

# --- App ---
# local | test | production
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# true in production
LOG_JSON=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the web app, used for links in emails
FRONTEND_URL=http://localhost:5173
# Host headers the API answers to. Production: your API hostname(s), never *.
ALLOWED_HOSTS=*
# Swagger UI / ReDoc / openapi.json. Empty = on locally, off in production.
API_DOCS_ENABLED=
# Max size of JSON (non-upload) request bodies.
MAX_JSON_BODY_KB=1024
# Fernet key(s) for at-rest field encryption. Comma-separated, newest first (rotation).
# Must differ from SECRET_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Database / Redis ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/advocate_dev
TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/advocate_test
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15

# --- Auth ---
JWT_SECRET_KEY=change-me-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_CLIENT_ID=
MFA_ISSUER=Advocate Platform
EMAIL_VERIFICATION_TTL_HOURS=48
# Account deletion: deactivated at once, anonymized after this many days (login cancels).
ACCOUNT_DELETION_GRACE_DAYS=14

# --- Email (MailHog/Mailpit locally on 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@example.com

# --- Bookings ---
DEFAULT_ADVOCATE_TIMEZONE=Asia/Kolkata
BOOKING_HORIZON_DAYS=60
BOOKING_MIN_LEAD_MINUTES=30
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
BOOKING_CURRENCY=INR
# Client cancellation >= this many hours before start -> full refund, otherwise none
CANCELLATION_FULL_REFUND_HOURS=24
RESCHEDULE_CUTOFF_HOURS=24

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Object storage (S3-compatible; SeaweedFS locally, see docker/seaweedfs/s3.json) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=devaccess
S3_SECRET_KEY=devsecret-local-only
S3_BUCKET=advocate-files
S3_PRESIGN_TTL_SECONDS=300
CASE_DOCUMENT_MAX_MB=20
# Profile images: PNG/JPEG, re-encoded without metadata
AVATAR_MAX_MB=2
AVATAR_MAX_PIXELS=4096

# --- Realtime / chat ---
# WebSocket clients get a single-use ticket from POST /api/v1/realtime/ticket (valid this long).
WS_TICKET_TTL_SECONDS=30
# WebSocket Origin must be in CORS_ORIGINS. Only allow a missing Origin for local tooling.
WS_ALLOW_MISSING_ORIGIN=false
CHAT_RATE_LIMIT_MESSAGES=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=10
CHAT_ATTACHMENT_MAX_MB=20
CHAT_EDIT_WINDOW_MINUTES=15
CHAT_NOTIFY_THROTTLE_MINUTES=10

# --- Database pool / timeouts (per process) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

# --- Outbound calls (Razorpay, Google, S3) ---
EXTERNAL_CONNECT_TIMEOUT_SECONDS=5
EXTERNAL_READ_TIMEOUT_SECONDS=15

# --- Observability (both optional) ---
# Sentry error monitoring; off when empty. PII is scrubbed before sending.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# GET /metrics (Prometheus) is off when empty. Scrapers send "Authorization: Bearer <token>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_TOKEN=
